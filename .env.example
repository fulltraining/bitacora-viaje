# ============================================================
# Bitácora de Viaje · configuración de Supabase
#
# Copia este archivo a ".env" (o ".env.local") y rellena los valores
# con los de tu proyecto de Supabase:
#   Project Settings → Data API → Project URL
#   Project Settings → API Keys → anon public key
#
# Si prefieres no usar variables de entorno, puedes introducir estos
# mismos datos desde la pantalla "Configuración" de la aplicación
# (se guardan en el dispositivo).
# ============================================================

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
